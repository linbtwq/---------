// возвращает json с учетными остатками и ценами для перерасчета
// цена берется из ассортимента пополнения по коду номенклатуры
Функция ВернутьПерерасчет(КодТТ)
	// пустой код точки
	Если ПустаяСтрока(СокрЛП(КодТТ)) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	ТТОбъект = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТТ));

	// точка не найдена
	Если НЕ ЗначениеЗаполнено(ТТОбъект) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Торгова точка не знайдена");
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	НоменклатураТРО = ТТОбъект.НоменклатураТРО;

	// у точки не указано оборудование
	Если НЕ ЗначениеЗаполнено(НоменклатураТРО) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "ТРО не вказано");
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	// учетные остатки по точке
	ЗапросОстатки = Новый Запрос;
	ЗапросОстатки.Текст =
	"ВЫБРАТЬ
	|  СУММА(КофейныеАппаратыОстаткиОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Код КАК Код,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Наименование КАК Наименование
	|ИЗ
	|  РегистрНакопления.КофейныеАппаратыОстатки.Остатки КАК КофейныеАппаратыОстаткиОстатки
	|ГДЕ
	|  КофейныеАппаратыОстаткиОстатки.ТРО = &ТРО
	|  И КофейныеАппаратыОстаткиОстатки.ТорговаяТочка = &ТорговаяТочка
	|СГРУППИРОВАТЬ ПО
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Код,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Наименование";

	ЗапросОстатки.УстановитьПараметр("ТРО", НоменклатураТРО);
	ЗапросОстатки.УстановитьПараметр("ТорговаяТочка", ТТОбъект);

	// карта цен по коду номенклатуры из ассортимента пополнения
	КартаЦен = Новый Соответствие;
	Ассортимент = НоменклатураТРО.АссортиментПополнения;
	Если ЗначениеЗаполнено(Ассортимент) Тогда
		ЗапросЦены = Новый Запрос;
		ЗапросЦены.Текст =
		"ВЫБРАТЬ
		|  Состав.Номенклатура.Код КАК Код,
		|  Состав.Цена КАК Цена
		|ИЗ
		|  Справочник.КаваАссортиментыПополнения.Состав КАК Состав
		|ГДЕ
		|  Состав.Ссылка = &Ссылка";
		ЗапросЦены.УстановитьПараметр("Ссылка", Ассортимент);
		ВыборкаЦен = ЗапросЦены.Выполнить().Выбрать();
		Пока ВыборкаЦен.Следующий() Цикл
			КартаЦен.Вставить(СокрЛП(ВыборкаЦен.Код), ВыборкаЦен.Цена);
		КонецЦикла;
	КонецЕсли;

	// собираем ответ с остатками и ценами
	МассивДанных = Новый Массив;
	Выборка = ЗапросОстатки.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КодТовара = СокрЛП(Выборка.Код);

		// если цены нет в ассортименте считаем ее нулевой
		Цена = 0;
		Если КартаЦен[КодТовара] <> Неопределено Тогда
			Цена = КартаЦен[КодТовара];
		КонецЕсли;

		Данные = Новый Структура;
		Данные.Вставить("Code", КодТовара);
		Данные.Вставить("Name", Выборка.Наименование);
		Данные.Вставить("price", Цена);
		// book это учетное количество а quantity дублирует его для совместимости
		Данные.Вставить("book", Выборка.КоличествоОстаток);
		Данные.Вставить("quantity", Выборка.КоличествоОстаток);

		МассивДанных.Добавить(Данные);
	КонецЦикла;

	// остатков нет совсем
	Если МассивДанных.Количество() = 0 Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Залишки відсутні");
		МассивДанных.Добавить(Данные);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// сохраняет результат перерасчета остатков
// сравнивает фактическое количество с учетным и пишет разницу
// положительная разница идет в приход а отрицательная в расход
Функция POST_Recount(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки    = Данные.point_id;
		КодСотр     = Данные.technician_id;
		МассивСтрок = Данные.items;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если у документа есть реквизит ID_Запроса)
		ЕстьIDПерерасчета = ЕстьРеквизитIDЗапроса("КофейныеАппаратыПерерахунок");
		Если ЕстьIDПерерасчета И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КофейныеАппаратыПерерахунок ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				Результат = Новый Структура("ok, doc_number, doc_date, sum, stock_error, conduct_error", Истина, "", "", 0, "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат);
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// значения по умолчанию для пользователя как в заказе и оплате
		ОсновнойМагазин      = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
		ОсновнаяОрганизация  = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяОрганизация");

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// не администратор работает только со своими точками
		Если Не Сотр.РольАдминистратора Тогда
			ЗапросДоступ = Новый Запрос;
			ЗапросДоступ.Текст =
			"ВЫБРАТЬ
			|	Точки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТорговыеТочки КАК Точки
			|ГДЕ
			|	Точки.Ссылка = &Точка
			|	И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
			ЗапросДоступ.УстановитьПараметр("Точка", ТочкаСсылка);
			ЗапросДоступ.УстановитьПараметр("ОсновнойМенеджер", Сотр);
			Если ЗапросДоступ.Выполнить().Пустой() Тогда
				ВызватьИсключение "Немає доступу до цієї точки.";
			КонецЕсли;
		КонецЕсли;

		Если МассивСтрок = Неопределено ИЛИ МассивСтрок.Количество() = 0 Тогда
			ВызватьИсключение "Порожній склад перерахунку.";
		КонецЕсли;

		// создаем документ перерасчета и заполняем шапку
		НовыйДок = Документы.КофейныеАппаратыПерерахунок.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент    = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО           = ТочкаСсылка.НоменклатураТРО;
		
		Если ЕстьIDПерерасчета Тогда
			Попытка НовыйДок.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		// организация и магазин обязательны для проведения на большинстве конфигураций
		Попытка
			НовыйДок.Организация = ОсновнаяОрганизация;
		Исключение
		КонецПопытки;

		Попытка
			НовыйДок.Магазин = ОсновнойМагазин;
		Исключение
		КонецПопытки;

		Если НовыйДок.Метаданные().Реквизиты.Найти("Автор") <> Неопределено Тогда
			НовыйДок.Автор = Пользователь;
		КонецЕсли;

		СуммаПроданойПродукции = 0;
		МассивПриход = Новый Массив;
		МассивРасход = Новый Массив;

		// разбираем строки перерасчета
		Для Каждого Стр Из МассивСтрок Цикл
			КодТовара = "";
			Если Стр.Свойство("code") Тогда
				КодТовара = СокрЛП(Стр.code);
			КонецЕсли;

			ИмяТовара = "";
			Если Стр.Свойство("name") Тогда
				ИмяТовара = СокрЛП(Стр.name);
			КонецЕсли;

			Цена = 0;
			Если Стр.Свойство("price") Тогда
				Цена = Число(Стр.price);
			КонецЕсли;

			// учет это количество по данным базы
			Учет = 0;
			Если Стр.Свойство("book") Тогда
				Учет = Число(Стр.book);
			КонецЕсли;

			// факт это количество насчитанное на месте
			Факт = 0;
			Если Стр.Свойство("actual") Тогда
				Факт = Число(Стр.actual);
			КонецЕсли;

			Отклонение = Факт - Учет;

			// ищем товар по коду а потом по наименованию
			Товар = Справочники.Номенклатура.ПустаяСсылка();
			Если Не ПустаяСтрока(КодТовара) Тогда
				Попытка
					Товар = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если Товар.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				Товар = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;
			Если Товар.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			СуммаОтклонения = Отклонение * Цена;
			СуммаПроданойПродукции = СуммаПроданойПродукции + СуммаОтклонения;

			НоваяСтр = НовыйДок.Состав.Добавить();
			НоваяСтр.Номенклатура = Товар;

			// реквизиты строки могут отличаться в разных версиях конфигурации
			Попытка
				НоваяСтр.УчетноеКоличество = Учет;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.Цена = Цена;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.СуммаОтклонения = СуммаОтклонения;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.ФактическоеКоличество = Факт;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.Отклонение = Отклонение;
			Исключение
			КонецПопытки;

			// отклонение раскладываем по массивам прихода и расхода
			// количество в движении всегда положительное
			Если Отклонение <> 0 Тогда
				СтрДв = Новый Структура;
				СтрДв.Вставить("Номенклатура", Товар);
				СтрДв.Вставить("Количество", ?(Отклонение > 0, Отклонение, -Отклонение));

				Если Отклонение > 0 Тогда
					МассивПриход.Добавить(СтрДв);
				Иначе
					МассивРасход.Добавить(СтрДв);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Если НовыйДок.Состав.Количество() = 0 Тогда
			ВызватьИсключение "Жодна позиція перерахунку не знайдена в номенклатурі.";
		КонецЕсли;

		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаПроданойПродукции;
		КонецЕсли;

		// проведение документа и перезапись движений идут в одной транзакции
		// документ при проведении пишет движения без торговой точки
		// из за этого запрос остатков по точке их не находит
		// поэтому сразу после проведения стираем кривые движения и пишем правильные
		НачатьТранзакцию();
		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);

			ПерезаписатьДвиженияПерерасчета(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				ТочкаСсылка.НоменклатураТРО,
				МассивПриход,
				МассивРасход
			);

			ЗафиксироватьТранзакцию();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("КофеПриложение.Перерасчет", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстОшибки);
			ВызватьИсключение "Перерахунок не збережено: " + ТекстОшибки;
		КонецПопытки;

		// поля с ошибками оставляем пустыми чтобы фронт не сломался
		ОшибкаПроведения = "";
		ОшибкаКоличества = "";

		// формируем ответ
		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(НовыйДок.Номер));
		Результат.Вставить("doc_date",      Формат(НовыйДок.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("sum",           СуммаПроданойПродукции);
		Результат.Вставить("stock_error",   ОшибкаКоличества);
		Результат.Вставить("conduct_error", ОшибкаПроведения);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ============================================================
// метод notes (примітки по точці)
// get отдает историю заметок а post добавляет новую
// заметки хранятся в справочнике заметок точек
// ============================================================

// проверяет что сотрудник может работать с точкой
Функция ДоступКТочкеРазрешен(Сотр, ТочкаСсылка)
	Если Сотр.РольАдминистратора Тогда
		Возврат Истина;
	КонецЕсли;

	ЗапросДоступ = Новый Запрос;
	ЗапросДоступ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Точки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТорговыеТочки КАК Точки
	|ГДЕ
	|	Точки.Ссылка = &Точка
	|	И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
	ЗапросДоступ.УстановитьПараметр("Точка", ТочкаСсылка);
	ЗапросДоступ.УстановитьПараметр("ОсновнойМенеджер", Сотр);

	Возврат Не ЗапросДоступ.Выполнить().Пустой();
КонецФункции


// собирает ответ с заголовками для cors
Функция ЗаметкиОтвет(КодОтвета, Тело, Методы, ЭтоJSON = Истина)
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", ?(ЭтоJSON, "application/json; charset=utf-8", "text/plain; charset=utf-8"));
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", Методы);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции


// превращает структуру или массив в строку json
Функция ЗаметкиВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// имя автора заметки для показа в истории
Функция ИмяАвтораЗаметки(Автор)
	Если Не ЗначениеЗаполнено(Автор) Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(Автор.Сотрудник) Тогда
		Возврат СокрЛП(Автор.Сотрудник.Наименование);
	КонецЕсли;

	Возврат СокрЛП(Автор.Наименование);
КонецФункции


// структура одной заметки в формате для фронта
Функция СтруктураЗаметки(Элемент)
	Заметка = Новый Структура;
	Заметка.Вставить("id",     Строка(Элемент.УникальныйИдентификатор()));
	Заметка.Вставить("author", ИмяАвтораЗаметки(Элемент.Автор));
	Заметка.Вставить("date",   Формат(Элемент.ДатаЗаметки, "ДФ=yyyy-MM-dd HH:mm:ss"));
	Заметка.Вставить("tag",    СокрЛП(Элемент.Метка));
	Заметка.Вставить("text",   Элемент.ТекстЗаметки);
	Возврат Заметка;
КонецФункции


// история заметок по точке от новых к старым
Функция notesget(Запрос)
	Методы = "GET, OPTIONS";
	Попытка
		КодСотр = Запрос.ПараметрыЗапроса.Получить("u");
		Если КодСотр = Неопределено Тогда
			КодСотр = "";
		КонецЕсли;

		КодТочки = Запрос.ПараметрыЗапроса.Получить("point");
		Если КодТочки = Неопределено Тогда
			КодТочки = "";
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		Если Не ДоступКТочкеРазрешен(Сотр, ТочкаСсылка) Тогда
			ВызватьИсключение "Немає доступу до цієї точки.";
		КонецЕсли;

		ЗапросЗаметок = Новый Запрос;
		ЗапросЗаметок.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Заметки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗаметкиТочек КАК Заметки
		|ГДЕ
		|	Заметки.ТорговаяТочка = &Точка
		|	И НЕ Заметки.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Заметки.ДатаЗаметки УБЫВ";
		ЗапросЗаметок.УстановитьПараметр("Точка", ТочкаСсылка);

		МассивДанных = Новый Массив;
		Выборка = ЗапросЗаметок.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивДанных.Добавить(СтруктураЗаметки(Выборка.Ссылка));
		КонецЦикла;

		Возврат ЗаметкиОтвет(200, ЗаметкиВJSON(МассивДанных), Методы);

	Исключение
		Возврат ЗаметкиОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции


// добавляет новую заметку
// повторный запрос с тем же идентификатором возвращает уже созданную заметку
Функция POST_Notes(Запрос)
	Методы = "POST, OPTIONS";
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки = СокрЛП(Строка(Данные.point_id));
		КодСотр  = Данные.technician_id;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = СокрЛП(Строка(Данные.request_id));
		КонецЕсли;

		ТекстЗаметки = "";
		Если Данные.Свойство("text") Тогда
			ТекстЗаметки = СокрЛП(Строка(Данные.text));
		КонецЕсли;

		// метка допустима только из известного списка иначе остается пустой
		Метка = "";
		Если Данные.Свойство("tag") Тогда
			Метка = СокрЛП(Строка(Данные.tag));
		КонецЕсли;
		Если Метка <> "access" И Метка <> "service" И Метка <> "broken" И Метка <> "other" Тогда
			Метка = "";
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		Если ПустаяСтрока(ТекстЗаметки) Тогда
			ВызватьИсключение "Примітка порожня.";
		КонецЕсли;

		Если СтрДлина(ТекстЗаметки) > 500 Тогда
			ВызватьИсключение "Примітка задовга, максимум 500 символів.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(КодТочки);
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		Если Не ДоступКТочкеРазрешен(Сотр, ТочкаСсылка) Тогда
			ВызватьИсключение "Немає доступу до цієї точки.";
		КонецЕсли;

		// если запрос уже обработан возвращаем прежнюю заметку без новой записи
		Если Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос;
			ЗапросДубль.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Заметки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ЗаметкиТочек КАК Заметки
			|ГДЕ
			|	Заметки.ID_Запроса = &RequestID";
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);

			ВыборкаДубль = ЗапросДубль.Выполнить().Выбрать();
			Если ВыборкаДубль.Следующий() Тогда
				Результат = Новый Структура;
				Результат.Вставить("ok", Истина);
				Результат.Вставить("note", СтруктураЗаметки(ВыборкаДубль.Ссылка));
				Возврат ЗаметкиОтвет(200, ЗаметкиВJSON(Результат), Методы);
			КонецЕсли;
		КонецЕсли;

		НовыйЭлемент = Справочники.ЗаметкиТочек.СоздатьЭлемент();
		НовыйЭлемент.ТорговаяТочка = ТочкаСсылка;
		НовыйЭлемент.Автор = Пользователь;
		НовыйЭлемент.ДатаЗаметки = ТекущаяДата();
		НовыйЭлемент.Метка = Метка;
		НовыйЭлемент.ТекстЗаметки = ТекстЗаметки;
		НовыйЭлемент.ID_Запроса = RequestID;
		НовыйЭлемент.Наименование = Лев(ТекстЗаметки, НовыйЭлемент.Метаданные().ДлинаНаименования);

		Попытка
			НовыйЭлемент.Записать();
		Исключение
			ТекстЖурнала = ОписаниеОшибки();
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("КофеПриложение.Заметки", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстЖурнала);
			ВызватьИсключение "Примітку не збережено: " + ТекстОшибки;
		КонецПопытки;

		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("note", СтруктураЗаметки(НовыйЭлемент.Ссылка));

		Возврат ЗаметкиОтвет(200, ЗаметкиВJSON(Результат), Методы);

	Исключение
		Возврат ЗаметкиОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода notes
Функция OPTIONS_Notes(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
	Возврат Ответ;
КонецФункции


// ============================================================
// метод goods (дерево номенклатуры для левой панели)
// с параметром parent показывает содержимое папки
// без параметра показывает корень
// с параметром q делает плоский поиск по всем товарам
// ============================================================

// собирает ответ с заголовками для cors
Функция ТоварыОтвет(КодОтвета, Тело, Методы, ЭтоJSON = Истина)
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", ?(ЭтоJSON, "application/json; charset=utf-8", "text/plain; charset=utf-8"));
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", Методы);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции


// превращает структуру или массив в строку json
Функция ТоварыВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// читает параметр запроса как строку и не падает если параметра нет
Функция ПараметрТоваров(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции


// превращает uuid из строки в ссылку на папку номенклатуры
// если uuid пустой или битый возвращает пустую ссылку
Функция ТоварыСсылкаПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Уид = Новый УникальныйИдентификатор(Ид);
		Возврат Справочники.Номенклатура.ПолучитьСсылку(Уид);
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;
КонецФункции


// строит хлебные крошки от корня до указанной папки
Функция ТоварыХлебныеКрошки(Ссылка)
	Крошки = Новый Массив;
	Текущий = Ссылка;

	Пока ЗначениеЗаполнено(Текущий) Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id",   Строка(Текущий.УникальныйИдентификатор()));
		Элемент.Вставить("name", СокрЛП(Текущий.Наименование));
		Крошки.Вставить(0, Элемент);
		Текущий = Текущий.Родитель;
	КонецЦикла;

	Возврат Крошки;
КонецФункции


// содержимое папки номенклатуры
// возвращает подпапки и товары которые лежат прямо в этой папке
Функция ТоварыСодержимое(ИдРодителя)
	РодительСсылка = ТоварыСсылкаПоИд(ИдРодителя);

	// если передан id но ссылка не нашлась падаем
	Если Не ПустаяСтрока(ИдРодителя) И РодительСсылка.Пустая() Тогда
		ВызватьИсключение "Групу не знайдено.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование,
	|	Ном.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Родитель = &Родитель
	|	И НЕ Ном.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	Наименование";
	Запрос.УстановитьПараметр("Родитель", РодительСсылка);

	Позиции = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", СокрЛП(Выборка.Наименование));
		Позиция.Вставить("type", ?(Выборка.ЭтоГруппа, "folder", "item"));

		Если НЕ Выборка.ЭтоГруппа Тогда
			Позиция.Вставить("code", СокрЛП(Выборка.Код));
		КонецЕсли;

		Позиции.Добавить(Позиция);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("parent",     ИдРодителя);
	Результат.Вставить("breadcrumb", ТоварыХлебныеКрошки(РодительСсылка));
	Результат.Вставить("items",      Позиции);
	Возврат Результат;
КонецФункции


// плоский поиск по всем товарам независимо от того где они лежат
Функция ТоварыПоиск(СтрокаПоиска)
	// спецсимволы поиска экранируем чтобы они искались как обычные
	Экранированная = СтрЗаменить(СтрокаПоиска, "~", "~~");
	Экранированная = СтрЗаменить(Экранированная, "%", "~%");
	Экранированная = СтрЗаменить(Экранированная, "_", "~_");
	Экранированная = СтрЗаменить(Экранированная, "[", "~[");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 51
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	НЕ Ном.ПометкаУдаления
	|	И НЕ Ном.ЭтоГруппа
	|	И (Ном.Наименование ПОДОБНО &Маска СПЕЦСИМВОЛ ""~""
	|		ИЛИ Ном.Код ПОДОБНО &Маска СПЕЦСИМВОЛ ""~"")
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Маска", "%" + Экранированная + "%");

	Позиции = Новый Массив;
	Усечено = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Позиции.Количество() >= 50 Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", СокрЛП(Выборка.Наименование));
		Позиция.Вставить("code", СокрЛП(Выборка.Код));
		Позиция.Вставить("type", "item");
		Позиции.Добавить(Позиция);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items",     Позиции);
	Результат.Вставить("truncated", Усечено);
	Возврат Результат;
КонецФункции


Функция goodsget(Запрос)
	Методы = "GET, OPTIONS";
	Попытка
		ПарамПользователя = ВернутьПараметрыСотрудника(ПараметрТоваров(Запрос, "u"));
		Если Не ЗначениеЗаполнено(ПарамПользователя.Сотрудник) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		СтрокаПоиска = ПараметрТоваров(Запрос, "q");

		// если строка поиска есть - плоский список без дерева
		Если Не ПустаяСтрока(СтрокаПоиска) Тогда
			Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыПоиск(СтрокаПоиска)), Методы);
		КонецЕсли;

		// иначе отдаем содержимое папки (или корня)
		ИдРодителя = ПараметрТоваров(Запрос, "parent");
		Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыСодержимое(ИдРодителя)), Методы);

	Исключение
		Возврат ТоварыОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции


