// возвращает json с остатками товаров на точке
// остатки берутся из регистра по связке тро и торговая точка
Функция ВернутьОстатокТТ(КодТТ)
	// пустой код точки
	Если ПустаяСтрока(СокрЛП(КодТТ)) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		Данные.Вставить("quantity", 0);
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	ТТОбъект = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТТ));

	// точка не найдена
	Если НЕ ЗначениеЗаполнено(ТТОбъект) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Торгова точка не знайдена");
		Данные.Вставить("quantity", 0);
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	НоменклатураТРО = ТТОбъект.НоменклатураТРО;

	// у точки не указано оборудование
	Если НЕ ЗначениеЗаполнено(НоменклатураТРО) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "ТРО не вказано");
		Данные.Вставить("quantity", 0);
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|  СУММА(КофейныеАппаратыОстаткиОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Код КАК Код,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Наименование КАК Наименование
	|ИЗ
	|  РегистрНакопления.КофейныеАппаратыОстатки.Остатки КАК КофейныеАппаратыОстаткиОстатки
	|ГДЕ
	|  КофейныеАппаратыОстаткиОстатки.ТРО = &ТРО
	|  И КофейныеАппаратыОстаткиОстатки.ТорговаяТочка = &ТорговаяТочка
	|СГРУППИРОВАТЬ ПО
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Код,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Наименование";

	Запрос.УстановитьПараметр("ТРО", НоменклатураТРО);
	Запрос.УстановитьПараметр("ТорговаяТочка", ТТОбъект);
	Выборка = Запрос.Выполнить().Выбрать();

	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("Code", СокрЛП(Выборка.Код));
		Данные.Вставить("Name", Выборка.Наименование);
		Данные.Вставить("quantity", Выборка.КоличествоОстаток);
		МассивДанных.Добавить(Данные);
	КонецЦикла;

	// остатков нет совсем
	Если МассивДанных.Количество() = 0 Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Залишки відсутні");
		Данные.Вставить("quantity", 0);
		МассивДанных.Добавить(Данные);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


