// ============================================================
// ОБЩАЯ ФУНКЦИЯ ДВИЖЕНИЙ ПО ДОЛГУ
// ============================================================

Процедура ЗаписатьДвижениеДолга(Регистратор, ТочкаСсылка, Сумма, ВидДвижения)
	
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сумма) ИЛИ Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыНакопления.КофейныеАппаратыОстатки.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	
	Движение = Набор.Добавить();
	Движение.Активность  = Истина;
	Движение.ВидДвижения = ВидДвижения;
	Движение.Период      = Регистратор.Дата;
	
	Если Метаданные.РегистрыНакопления.КофейныеАппаратыОстатки.Измерения.Найти("ТорговаяТочка") <> Неопределено Тогда
		Движение.ТорговаяТочка = ТочкаСсылка;
	КонецЕсли;
	
	Если Метаданные.РегистрыНакопления.КофейныеАппаратыОстатки.Ресурсы.Найти("Сумма") <> Неопределено Тогда
		Движение.Сумма = Сумма;
	КонецЕсли;
	
	Набор.Записать();
	
КонецПроцедуры


// ============================================================
// ОБЩАЯ ФУНКЦИЯ ДВИЖЕНИЙ ПО КОЛИЧЕСТВУ
// ============================================================

Процедура ЗаписатьДвиженияКоличества(Регистратор, ТочкаСсылка, ТРОСсылка, МассивДвижений, ВидДвижения)
	
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивДвижений = Неопределено ИЛИ МассивДвижений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыНакопления.КофейныеАппаратыОстатки.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	Набор.Прочитать();
	
	Для Каждого СтрДв Из МассивДвижений Цикл
		
		Если Не ЗначениеЗаполнено(СтрДв.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрДв.Количество) ИЛИ СтрДв.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Набор.Добавить();
		Движение.Активность  = Истина;
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период      = Регистратор.Дата;
		
		Если Метаданные.РегистрыНакопления.КофейныеАппаратыОстатки.Измерения.Найти("ТорговаяТочка") <> Неопределено Тогда
			Движение.ТорговаяТочка = ТочкаСсылка;
		КонецЕсли;
		
		Если Метаданные.РегистрыНакопления.КофейныеАппаратыОстатки.Измерения.Найти("ТРО") <> Неопределено Тогда
			Движение.ТРО = ТРОСсылка;
		КонецЕсли;
		
		Если Метаданные.РегистрыНакопления.КофейныеАппаратыОстатки.Измерения.Найти("Номенклатура") <> Неопределено Тогда
			Движение.Номенклатура = СтрДв.Номенклатура;
		КонецЕсли;
		
		Если Метаданные.РегистрыНакопления.КофейныеАппаратыОстатки.Ресурсы.Найти("Количество") <> Неопределено Тогда
			Движение.Количество = СтрДв.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры


// ============================================================
// nomenclature
// ============================================================

Функция nomenclatureget(Запрос)
	Попытка
		КодСотр = "";
		Для Каждого Заголовок Из Запрос.Заголовки Цикл
			Если НРег(Заголовок.Ключ) = "x-user-code" Тогда
				КодСотр = СокрЛП(Заголовок.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Сотр = НайтиСотрудника(КодСотр);
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Точки.Код КАК id,
		|	Точки.Наименование КАК point_name,
		|	ЕСТЬNULL(Точки.Контрагент.Наименование, """") КАК counterparty,
		|	ЕСТЬNULL(Точки.Адрес, """") КАК address,
		|	ЕСТЬNULL(Точки.НоменклатураТРО.Наименование, """") КАК coffee_machine,
		|	ЕСТЬNULL(Точки.НоменклатураТРО.Код, """") КАК coffee_machine_code,
		|	Точки.НоменклатураТРО КАК ТРОСсылка,
		|	ЕСТЬNULL(ОстаткиДолга.СуммаОстаток, 0) КАК debt,
		|	ВЫБОР КОГДА БлокДок.Точка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК locked,
		|	БлокДок.Дата КАК locked_at,
		|	ВЫБОР КОГДА БлокЗаказ.Точка ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК order_locked,
		|	БлокЗаказ.Дата КАК order_locked_at
		|ИЗ
		|	Справочник.ТорговыеТочки КАК Точки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ТорговаяТочка,
		|			СУММА(СуммаОстаток) КАК СуммаОстаток
		|		ИЗ
		|			РегистрНакопления.КофейныеАппаратыОстатки.Остатки
		|		СГРУППИРОВАТЬ ПО
		|			ТорговаяТочка) КАК ОстаткиДолга
		|		ПО Точки.Ссылка = ОстаткиДолга.ТорговаяТочка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокТЧ.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокТЧ.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ДокТЧ
		|		ГДЕ
		|			ДокТЧ.Ссылка.Проведен
		|			И ДокТЧ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокТЧ.Ссылка.ТорговаяТочка) КАК БлокДок
		|		ПО Точки.Ссылка = БлокДок.Точка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокЗ.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокЗ.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыПополнениеЗапасов.Состав КАК ДокЗ
		|		ГДЕ
		|			ДокЗ.Ссылка.Проведен
		|			И ДокЗ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокЗ.Ссылка.ТорговаяТочка) КАК БлокЗаказ
		|		ПО Точки.Ссылка = БлокЗаказ.Точка
		|ГДЕ
		|	Точки.ПометкаУдаления = ЛОЖЬ
		|	И (&ВсеТочки
		|		ИЛИ (&ЕстьСотрудник
		|			И (Точки.Контрагент В (
		|					ВЫБРАТЬ Аг.Ссылка
		|					ИЗ Справочник.Контрагенты.ТорговыеАгенты КАК Аг
		|					ГДЕ Аг.ТорговыйАгент = &Сотр)
		|				ИЛИ Точки.Контрагент В (
		|					ВЫБРАТЬ Мен.Ссылка
		|					ИЗ Справочник.Контрагенты.Менеджеры КАК Мен
		|					ГДЕ Мен.Менеджер = &Сотр))))";
		
		ЗапросБД = Новый Запрос(ТекстЗапроса);
		ЗапросБД.УстановитьПараметр("ВсеТочки", ЭтоАдминистратор(КодСотр));
		ЗапросБД.УстановитьПараметр("ЕстьСотрудник", Не Сотр.Пустая());
		ЗапросБД.УстановитьПараметр("Сотр", Сотр);
		ЗапросБД.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Выборка = ЗапросБД.Выполнить().Выбрать();
		
		МассивДанных = Новый Массив;
		Пока Выборка.Следующий() Цикл
			СтрокаДанных = Новый Структура;
			СтрокаДанных.Вставить("id", Выборка.id);
			СтрокаДанных.Вставить("point_name", Выборка.point_name);
			СтрокаДанных.Вставить("counterparty", Выборка.counterparty);
			СтрокаДанных.Вставить("address", Выборка.address);
			СтрокаДанных.Вставить("coffee_machine", Выборка.coffee_machine);
			СтрокаДанных.Вставить("coffee_machine_code", Выборка.coffee_machine_code);
			СтрокаДанных.Вставить("debt", Выборка.debt);
			
			СтрокаДанных.Вставить("locked", Выборка.locked);
			Если Выборка.locked Тогда
				СтрокаДанных.Вставить("locked_at", Формат(Выборка.locked_at, "ДЛФ=В"));
			КонецЕсли;

			СтрокаДанных.Вставить("order_locked", Выборка.order_locked);
			Если Выборка.order_locked Тогда
				СтрокаДанных.Вставить("order_locked_at", Формат(Выборка.order_locked_at, "ДЛФ=В"));
			КонецЕсли;
			
			// ─── ассортимент по ТРО (без заглушки) ───
			МассивАссортимента = Новый Массив;
			Если ЗначениеЗаполнено(Выборка.ТРОСсылка) Тогда
				Для Каждого СтрокаТЧ Из Выборка.ТРОСсылка.АссортиментыПоТоварам Цикл
					СтруктураАссортимента = Новый Структура;
					СтруктураАссортимента.Вставить("name", СтрокаТЧ.Номенклатура.Наименование);
					СтруктураАссортимента.Вставить("price", СтрокаТЧ.Цена);
					СтруктураАссортимента.Вставить("last_meter", СтрокаТЧ.ПоследниеДанныеСчетчика);
					МассивАссортимента.Добавить(СтруктураАссортимента);
				КонецЦикла;
			КонецЕсли;
			
			СтрокаДанных.Вставить("assortment", МассивАссортимента);
			МассивДанных.Добавить(СтрокаДанных);
		КонецЦикла;
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		
		Возврат Ответ;
		
	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("Помилка 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		
		Возврат Ответ;
	КонецПопытки;
КонецФункции


Функция nomenclatureoptions(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
	Возврат Ответ;
КонецФункции


// ============================================================
// meters
// ============================================================

Функция POST_Meters(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		КодТочки = Данные.point_id;
		МассивСтрок = Данные.meters;
		КодСотр = Данные.technician_id;
		
		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(КодТочки);
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;
		
		Если Не ЭтоАдминистратор(КодСотр) Тогда
			ЗапросПроверки = Новый Запрос;
			ЗапросПроверки.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДокТЧ.Ссылка
			|ИЗ
			|	Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ДокТЧ
			|ГДЕ
			|	ДокТЧ.Ссылка.Проведен
			|	И ДокТЧ.Ссылка.ТорговаяТочка = &ТорговаяТочка
			|	И ДокТЧ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)";
			ЗапросПроверки.УстановитьПараметр("ТорговаяТочка", ТочкаСсылка);
			ЗапросПроверки.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
			
			Если Не ЗапросПроверки.Выполнить().Пустой() Тогда
				Ответ = Новый HTTPСервисОтвет(409); 
				Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
				Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
				Ответ.УстановитьТелоИзСтроки("Показники по цій точці вже внесені сьогодні.", КодировкаТекста.UTF8);
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
		
		НовыйДок = Документы.КофейныеАппаратыОбслуживание.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО = ТочкаСсылка.НоменклатураТРО;
		
		ОборудованиеОбъект = ТочкаСсылка.НоменклатураТРО.ПолучитьОбъект();
		
		РезКалькуляция = Неопределено;
		Если ОборудованиеОбъект <> Неопределено И ОборудованиеОбъект.АссортиментыПоТоварам.Количество() > 0 Тогда
			Для Каждого СтрОбор Из ОборудованиеОбъект.АссортиментыПоТоварам Цикл
				Если ЗначениеЗаполнено(СтрОбор.Калькуляция) Тогда
					РезКалькуляция = СтрОбор.Калькуляция;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РезКалькуляция) Тогда
			Попытка
				ЗапросКальк = Новый Запрос;
				ЗапросКальк.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Калькуляция";
				ВыборкаКальк = ЗапросКальк.Выполнить().Выбрать();
				Если ВыборкаКальк.Следующий() Тогда
					РезКалькуляция = ВыборкаКальк.Ссылка;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		СуммаОбщая = 0;
		МассивКоличества = Новый Массив;
		
		Для Каждого Стр Из МассивСтрок Цикл
			НоваяТЧ = НовыйДок.Ассортимент.Добавить();
			
			ЭлементНоменклатуры = Справочники.Номенклатура.НайтиПоНаименованию(Стр.name);
			Если Не ЭлементНоменклатуры.Пустая() Тогда
				НоваяТЧ.Номенклатура = ЭлементНоменклатуры;
				
				НайденнаяКарта = Неопределено;
				ПрошлыйСчетчик = 0;
				
				Если ОборудованиеОбъект <> Неопределено Тогда
					Для Каждого СтрОборудования Из ОборудованиеОбъект.АссортиментыПоТоварам Цикл
						Если СтрОборудования.Номенклатура = ЭлементНоменклатуры Тогда
							НайденнаяКарта = СтрОборудования.Калькуляция;
							ПрошлыйСчетчик = СтрОборудования.ПоследниеДанныеСчетчика;
							
							СтрОборудования.ПоследниеДанныеСчетчика = Стр.value;
							
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(НайденнаяКарта) Тогда
					НайденнаяКарта = РезКалькуляция;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НайденнаяКарта) Тогда
					НоваяТЧ.ТехнологическаяКарта = НайденнаяКарта;
				КонецЕсли;
				
				НоваяТЧ.Счетчик = ПрошлыйСчетчик;
				
				Если Стр.delta > 0 Тогда
					СтрокаКол = Новый Структура;
					СтрокаКол.Вставить("Номенклатура", ЭлементНоменклатуры);
					СтрокаКол.Вставить("Количество", Стр.delta);
					МассивКоличества.Добавить(СтрокаКол);
				КонецЕсли;
			КонецЕсли;
			
			НоваяТЧ.Цена = Стр.price;
			НоваяТЧ.СчетчикТекущий = Стр.value;
			НоваяТЧ.Количество = Стр.delta;
			НоваяТЧ.Сумма = Стр.total;
			
			СуммаОбщая = СуммаОбщая + Стр.total;
		КонецЦикла;
		
		Если ОборудованиеОбъект <> Неопределено Тогда
			ОборудованиеОбъект.Записать();
		КонецЕсли;
		
		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаОбщая;
		КонецЕсли;
		
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
		
		ОшибкаДолга = "";
		Попытка
			ЗаписатьДвижениеДолга(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				СуммаОбщая,
				ВидДвиженияНакопления.Приход
			);
		Исключение
			ОшибкаДолга = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Долг", УровеньЖурналаРегистрации.Ошибка,
				, НовыйДок.Ссылка, ОшибкаДолга);
		КонецПопытки;
		
		ОшибкаКоличества = "";
		Попытка
			ЗаписатьДвиженияКоличества(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				ТочкаСсылка.НоменклатураТРО,
				МассивКоличества,
				ВидДвиженияНакопления.Расход
			);
		Исключение
			ОшибкаКоличества = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Остатки", УровеньЖурналаРегистрации.Ошибка,
				, НовыйДок.Ссылка, ОшибкаКоличества);
		КонецПопытки;
		
		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("sum", СуммаОбщая);
		Результат.Вставить("debt_error", ОшибкаДолга);
		Результат.Вставить("stock_error", ОшибкаКоличества);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		
		Возврат Ответ;
		
	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


