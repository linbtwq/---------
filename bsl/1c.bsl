// проверяет пин код и возвращает json с именем и признаком администратора
// если пользователь не найден возвращается код ноль и имя не найдено
Функция АвторизоватьПользователя(КодАвторизации)
	Данные = Новый Структура;

	Если ПустаяСтрока(КодАвторизации) Тогда
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		Данные.Вставить("IsAdmin", Ложь);
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.КодКарты КАК КодКарты,
		|	Пользователи.Сотрудник.Наименование КАК Имя,
		|	ЕСТЬNULL(Пользователи.Сотрудник.РольАдминистратора, ЛОЖЬ) КАК РольАдминистратора
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.КодКарты = &Код
		|	И НЕ Пользователи.ПометкаУдаления";
		Запрос.УстановитьПараметр("Код", СокрЛП(КодАвторизации));
		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			Данные.Вставить("Code", СокрЛП(Выборка.КодКарты));
			Данные.Вставить("Name", Выборка.Имя);
			Данные.Вставить("IsAdmin", Выборка.РольАдминистратора);
		Иначе
			Данные.Вставить("Code", "0");
			Данные.Вставить("Name", "НЕ ЗНАЙДЕНО");
			Данные.Вставить("IsAdmin", Ложь);
		КонецЕсли;
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


