// ============================================================
// orders
// ============================================================

Функция POST_Orders(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки    = Данные.point_id;
		КодСотр     = Данные.technician_id;
		МассивСтрок = Данные.items;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		Если Не ЭтоАдминистратор(КодСотр) Тогда
			Сотр = НайтиСотрудника(КодСотр);
			Если Сотр.Пустая() Тогда
				ВызватьИсключение "Співробітника не знайдено.";
			КонецЕсли;

			ЗапросДоступ = Новый Запрос;
			ЗапросДоступ.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Точки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТорговыеТочки КАК Точки
			|ГДЕ
			|	Точки.Ссылка = &Точка
			|	И (Точки.Контрагент В (
			|			ВЫБРАТЬ
			|				Аг.Ссылка
			|			ИЗ
			|				Справочник.Контрагенты.ТорговыеАгенты КАК Аг
			|			ГДЕ
			|				Аг.ТорговыйАгент = &Сотр)
			|		ИЛИ Точки.Контрагент В (
			|			ВЫБРАТЬ
			|				Мен.Ссылка
			|			ИЗ
			|				Справочник.Контрагенты.Менеджеры КАК Мен
			|			ГДЕ
			|				Мен.Менеджер = &Сотр))";
			ЗапросДоступ.УстановитьПараметр("Точка", ТочкаСсылка);
			ЗапросДоступ.УстановитьПараметр("Сотр",  Сотр);

			Если ЗапросДоступ.Выполнить().Пустой() Тогда
				ВызватьИсключение "Немає доступу до цієї точки.";
			КонецЕсли;
		КонецЕсли;

		Если МассивСтрок = Неопределено ИЛИ МассивСтрок.Количество() = 0 Тогда
			ВызватьИсключение "Порожній склад замовлення.";
		КонецЕсли;

		НовыйДок = Документы.КофейныеАппаратыПополнениеЗапасов.СоздатьДокумент();
		НовыйДок.Дата          = ТекущаяДата();
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент    = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО           = ТочкаСсылка.НоменклатураТРО;

		СотрАвтор = НайтиСотрудника(КодСотр);
		Если Не СотрАвтор.Пустая()
			И НовыйДок.Метаданные().Реквизиты.Найти("Автор") <> Неопределено Тогда
			НовыйДок.Автор = СотрАвтор;
		КонецЕсли;

		СуммаОбщая = 0;
		МассивКоличества = Новый Массив;

		Для Каждого Стр Из МассивСтрок Цикл

			КодТовара = "";
			Если Стр.Свойство("code") Тогда
				КодТовара = СокрЛП(Стр.code);
			КонецЕсли;

			ИмяТовара = "";
			Если Стр.Свойство("name") Тогда
				ИмяТовара = СокрЛП(Стр.name);
			КонецЕсли;

			Кол = 0;
			Если Стр.Свойство("qty") Тогда
				Кол = Число(Стр.qty);
			КонецЕсли;

			Цена = 0;
			Если Стр.Свойство("price") Тогда
				Цена = Число(Стр.price);
			КонецЕсли;

			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Товар = Справочники.Номенклатура.ПустаяСсылка();

			Если Не ПустаяСтрока(КодТовара) Тогда
				Попытка
					Товар = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
				Исключение
					Товар = Справочники.Номенклатура.ПустаяСсылка();
				КонецПопытки;
			КонецЕсли;

			Если Товар.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				Товар = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;

			Если Товар.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтр = НовыйДок.Состав.Добавить();
			НоваяСтр.Номенклатура = Товар;
			НоваяСтр.Количество   = Кол;
			НоваяСтр.Цена         = Цена;
			НоваяСтр.Сумма        = Кол * Цена;

			СуммаОбщая = СуммаОбщая + НоваяСтр.Сумма;

			СтрокаКол = Новый Структура;
			СтрокаКол.Вставить("Номенклатура", Товар);
			СтрокаКол.Вставить("Количество", Кол);
			МассивКоличества.Добавить(СтрокаКол);

		КонецЦикла;

		Если НовыйДок.Состав.Количество() = 0 Тогда
			ВызватьИсключение "Жодна позиція замовлення не знайдена в номенклатурі.";
		КонецЕсли;

		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаОбщая;
		КонецЕсли;

		ОшибкаПроведения = "";

		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОшибкаПроведения = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Заказ",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не вдалося провести документ замовлення: " + ОшибкаПроведения);

			Попытка
				НовыйДок.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				ВызватьИсключение "Не вдалося записати документ: " + ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;

		ОшибкаДолга = "";
		Попытка
			ЗаписатьДвижениеДолга(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				СуммаОбщая,
				ВидДвиженияНакопления.Приход
			);
		Исключение
			ОшибкаДолга = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Долг", УровеньЖурналаРегистрации.Ошибка,
				, НовыйДок.Ссылка, ОшибкаДолга);
		КонецПопытки;

		ОшибкаКоличества = "";
		Попытка
			ЗаписатьДвиженияКоличества(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				ТочкаСсылка.НоменклатураТРО,
				МассивКоличества,
				ВидДвиженияНакопления.Приход
			);
		Исключение
			ОшибкаКоличества = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Остатки", УровеньЖурналаРегистрации.Ошибка,
				, НовыйДок.Ссылка, ОшибкаКоличества);
		КонецПопытки;

		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(НовыйДок.Номер));
		Результат.Вставить("doc_date",      Формат(НовыйДок.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("sum",           СуммаОбщая);
		Результат.Вставить("debt_error",    ОшибкаДолга);
		Результат.Вставить("stock_error",   ОшибкаКоличества);
		Результат.Вставить("conduct_error", ОшибкаПроведения);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);

		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


