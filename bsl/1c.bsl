Функция POST_login(Запрос)
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Возврат Ответ;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	ПинКод = ДанныеЗапроса.pin;
	
	РезультатJSON = АвторизоватьПользователя(ПинКод);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, X-User-Code");
	
	Ответ.УстановитьТелоИзСтроки(РезультатJSON, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции


Функция OPTIONS_login(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, X-User-Code");
	
	Возврат Ответ;
	
КонецФункции


Функция АвторизоватьПользователя(КодАвторизации)
	
	Данные = Новый Структура;
	
	Если ПустаяСтрока(КодАвторизации) Тогда
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Сотрудник.Ссылка КАК Пользователь
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.КодКарты = &Код
		|	И НЕ Пользователи.ПометкаУдаления";
		Запрос.УстановитьПараметр("Код", СокрЛП(КодАвторизации));
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Данные.Вставить("Code", Выборка.Пользователь.Код);
			Данные.Вставить("Name", Выборка.Пользователь.Наименование);
		Иначе
			Данные.Вставить("Code", "0");
			Данные.Вставить("Name", "НЕ ЗНАЙДЕНО");
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции


Функция НайтиСотрудника(КодСотр)   
	
	Результат = Справочники.Сотрудники.ПустаяСсылка();
	
	Если ПустаяСтрока(КодСотр) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат = Справочники.Сотрудники.НайтиПоКоду(КодСотр);
	Исключение
	КонецПопытки;
	
	Если Результат.Пустая() Тогда
		Попытка
			Результат = Справочники.Сотрудники.НайтиПоКоду(Число(КодСотр));
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция ЭтоАдминистратор(КодСотрудника)
	Возврат СокрЛП(КодСотрудника) = "9";
