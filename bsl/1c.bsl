// возвращает json со списком позиций ассортимента пополнения для точки
// в каждой позиции код наименование цена и минимальный запас
// при проблемах возвращает массив из одной заглушки с пояснением в поле name
Функция ВернутьАсортимент(КодТТ)
	// пустой код точки
	Если ПустаяСтрока(КодТТ) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		Данные.Вставить("price", 0);
		Данные.Вставить("minStock",  0);
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	ТТОбъект = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТТ));

	// точка не найдена
	Если НЕ ЗначениеЗаполнено(ТТОбъект) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Торгова точка не знайдена");
		Данные.Вставить("price", 0);
		Данные.Вставить("minStock",  0);
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	Ассортимент = ТТОбъект.НоменклатураТРО.АссортиментПополнения;

	// у оборудования не указан ассортимент пополнения
	Если НЕ ЗначениеЗаполнено(Ассортимент) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Асортимент не вказано");
		Данные.Вставить("price", 0);
		Данные.Вставить("minStock",  0);
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|  АссортиментыСостав.Номенклатура.Код КАК Код,
	|  АссортиментыСостав.Номенклатура.Наименование КАК Наименование,
	|  АссортиментыСостав.Цена КАК Цена,
	|  АссортиментыСостав.МинимальныйЗапас КАК МинимальныйЗапас
	|ИЗ
	|  Справочник.КаваАссортиментыПополнения.Состав КАК АссортиментыСостав
	|ГДЕ
	|  АссортиментыСостав.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ассортимент);
	Выборка = Запрос.Выполнить().Выбрать();

	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("Code", СокрЛП(Выборка.Код));
		Данные.Вставить("Name", Выборка.Наименование);
		Данные.Вставить("price", Выборка.Цена);
		Данные.Вставить("minStock", Выборка.МинимальныйЗапас);
		МассивДанных.Добавить(Данные);
	КонецЦикла;

	// ассортимент указан но в нем нет строк
	Если МассивДанных.Количество() = 0 Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Асортимент порожній");
		Данные.Вставить("price", 0);
		Данные.Вставить("minStock",  0);
		МассивДанных.Добавить(Данные);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// ============================================================
// метод orders (заказ пополнения запасов)
// создает документ пополнения запасов по точке
// ============================================================
Функция POST_Orders(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки    = Данные.point_id;
		КодСотр     = Данные.technician_id;
		МассивСтрок = Данные.items;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если у документа есть реквизит ID_Запроса)
		ЕстьIDЗаказа = ЕстьРеквизитIDЗапроса("КофейныеАппаратыПополнениеЗапасов");
		Если ЕстьIDЗаказа И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КофейныеАппаратыПополнениеЗапасов ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				Результат = Новый Структура("ok, doc_number, doc_date, sum, debt_error, stock_error, conduct_error", Истина, "", "", 0, "", "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат);
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		ОсновнойМагазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
		ОсновнаяОрганизация = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяОрганизация");

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// не администратор работает только со своими точками
		Если Не Сотр.РольАдминистратора Тогда
			ЗапросДоступ = Новый Запрос;
			ЗапросДоступ.Текст =
			"ВЫБРАТЬ
			|	Точки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТорговыеТочки КАК Точки
			|ГДЕ
			|	Точки.Ссылка = &Точка
			|	И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
			ЗапросДоступ.УстановитьПараметр("Точка", ТочкаСсылка);
			ЗапросДоступ.УстановитьПараметр("ОсновнойМенеджер", Сотр);
			Если ЗапросДоступ.Выполнить().Пустой() Тогда
				ВызватьИсключение "Немає доступу до цієї точки.";
			КонецЕсли;
		КонецЕсли;

		Если МассивСтрок = Неопределено ИЛИ МассивСтрок.Количество() = 0 Тогда
			ВызватьИсключение "Порожній склад замовлення.";
		КонецЕсли;

		// создаем документ пополнения и заполняем шапку
		НовыйДок = Документы.КофейныеАппаратыПополнениеЗапасов.СоздатьДокумент();
		НовыйДок.Дата          = ТекущаяДата();
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент    = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО           = ТочкаСсылка.НоменклатураТРО;
		НовыйДок.Автор         = Пользователь;
		НовыйДок.Организация   = ОсновнаяОрганизация;
		НовыйДок.Магазин       = ОсновнойМагазин;

		Если ЕстьIDЗаказа Тогда
			Попытка НовыйДок.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		СуммаОбщая = 0;
		МассивКоличества = Новый Массив;

		// разбираем строки заказа
		Для Каждого Стр Из МассивСтрок Цикл
			// поля code name qty price могут отсутствовать поэтому проверяем каждое
			КодТовара = "";
			Если Стр.Свойство("code") Тогда
				КодТовара = СокрЛП(Стр.code);
			КонецЕсли;

			ИмяТовара = "";
			Если Стр.Свойство("name") Тогда
				ИмяТовара = СокрЛП(Стр.name);
			КонецЕсли;

			Кол = 0;
			Если Стр.Свойство("qty") Тогда
				Кол = Число(Стр.qty);
			КонецЕсли;

			Цена = 0;
			Если Стр.Свойство("price") Тогда
				Цена = Число(Стр.price);
			КонецЕсли;

			// строки с нулевым количеством пропускаем
			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			// сначала ищем товар по коду
			Товар = Справочники.Номенклатура.ПустаяСсылка();
			Если Не ПустаяСтрока(КодТовара) Тогда
				Попытка
					Товар = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
				Исключение
					Товар = Справочники.Номенклатура.ПустаяСсылка();
				КонецПопытки;
			КонецЕсли;

			// если по коду не нашли ищем по наименованию
			Если Товар.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				Товар = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;

			// товар не найден строку пропускаем
			Если Товар.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтр = НовыйДок.Состав.Добавить();
			НоваяСтр.Номенклатура = Товар;
			НоваяСтр.Количество   = Кол;
			НоваяСтр.Цена         = Цена;
			НоваяСтр.Сумма        = Кол * Цена;

			СуммаОбщая = СуммаОбщая + НоваяСтр.Сумма;

			СтрокаКол = Новый Структура;
			СтрокаКол.Вставить("Номенклатура", Товар);
			СтрокаКол.Вставить("Количество", Кол);
			МассивКоличества.Добавить(СтрокаКол);
		КонецЦикла;

		Если НовыйДок.Состав.Количество() = 0 Тогда
			ВызватьИсключение "Жодна позиція замовлення не знайдена в номенклатурі.";
		КонецЕсли;

		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаОбщая;
		КонецЕсли;

		// пробуем провести документ
		// если проведение не удалось пишем ошибку в журнал и сохраняем без проведения
		// здесь один документ поэтому транзакция не нужна
		ОшибкаПроведения = "";
		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОшибкаПроведения = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Заказ",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не вдалося провести документ замовлення: " + ОшибкаПроведения);
			Попытка
				НовыйДок.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				ВызватьИсключение "Не вдалося записати документ: " + ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;

		// заказ не двигает долг а только остатки
		ОшибкаДолга = "";

		ОшибкаКоличества = "";
		Попытка
			ЗаписатьДвиженияКоличества(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				ТочкаСсылка.НоменклатураТРО,
				МассивКоличества,
				ВидДвиженияНакопления.Приход
			);
		Исключение
			ОшибкаКоличества = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Остатки", УровеньЖурналаРегистрации.Ошибка,
				, НовыйДок.Ссылка, ОшибкаКоличества);
		КонецПопытки;

		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(НовыйДок.Номер));
		Результат.Вставить("doc_date",      Формат(НовыйДок.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("sum",           СуммаОбщая);
		Результат.Вставить("debt_error",    ОшибкаДолга);
		Результат.Вставить("stock_error",   ОшибкаКоличества);
		Результат.Вставить("conduct_error", ОшибкаПроведения);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


