// ищет пользователя и сотрудника по коду карты (пин коду)
// возвращает структуру с ключами пользователь и сотрудник
// если ничего не найдено возвращает пустые ссылки
Функция ВернутьПараметрыСотрудника(КодСотр)
	Результат = Новый Структура;
	КодСотр = СокрЛП(КодСотр);
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Пользователь = Справочники.Пользователи.ПустаяСсылка();

	// пустой код сразу отдаем пустой результат
	Если ПустаяСтрока(КодСотр) Тогда
		Результат.Вставить("Пользователь", Пользователь);
		Результат.Вставить("Сотрудник", Сотрудник);
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка,
	|	Пользователи.Сотрудник КАК Сотрудник
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.КодКарты = &КодКарты";

	Запрос.УстановитьПараметр("КодКарты", КодСотр);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// берем первую найденную запись
	Пока Выборка.Следующий() Цикл
		Результат.Вставить("Пользователь", Выборка.Ссылка);
		Результат.Вставить("Сотрудник", Выборка.Сотрудник);
		Возврат Результат;
	КонецЦикла;

	// если никого не нашли возвращаем пустые значения
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Сотрудник", Сотрудник);
	Возврат Результат;

КонецФункции


// проверяет есть ли у документа реквизит ID_Запроса
// нужен чтобы код не падал на конфигурациях где этого реквизита нет
// если реквизита нет то и защита от дублей просто не работает
Функция ЕстьРеквизитIDЗапроса(ИмяДокумента)
	Попытка
		МетаданныеДок = Метаданные.Документы[ИмяДокумента];
		Если МетаданныеДок = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат МетаданныеДок.Реквизиты.Найти("ID_Запроса") <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции


// возвращает текущий остаток долга по связке контрагент тро и торговая точка
// сейчас нигде не вызывается но может пригодиться
Функция ДолгПоТочке(Контрагент, ТорговаяТочка, ТРО)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(КофеТТВзаиморасчетыОстатки.СуммаОстаток) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.КофеТТВзаиморасчеты.Остатки КАК КофеТТВзаиморасчетыОстатки
		|ГДЕ
		|	КофеТТВзаиморасчетыОстатки.Контрагент = &Контрагент
		|	И КофеТТВзаиморасчетыОстатки.ТРО = &ТРО
		|	И КофеТТВзаиморасчетыОстатки.ТорговаяТочка = &ТорговаяТочка";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТорговаяТочка", ТорговаяТочка);
	Запрос.УстановитьПараметр("ТРО", ТРО);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		Возврат Выборка.СуммаОстаток;
	КонецЦикла;

	Возврат 0;
КонецФункции


// пишет одно движение в регистр взаиморасчетов
// вид движения приход уменьшает долг а расход увеличивает
// регистратор это документ который породил движение
Процедура ЗаписатьДвижениеДолга(Регистратор, ТочкаСсылка, Сумма, ВидДвижения)
	// без регистратора писать движение нельзя
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;

	// нулевая сумма не нужна
	Если Не ЗначениеЗаполнено(Сумма) ИЛИ Сумма = 0 Тогда
		Возврат;
	КонецЕсли;

	Набор = РегистрыНакопления.КофеТТВзаиморасчеты.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);

	Движение = Набор.Добавить();
	Движение.Активность    = Истина;
	Движение.ВидДвижения   = ВидДвижения;
	Движение.Период        = Регистратор.Дата;
	Движение.Контрагент    = ТочкаСсылка.Контрагент;
	Движение.ТРО           = ТочкаСсылка.НоменклатураТРО;
	Движение.ТорговаяТочка = ТочкаСсылка;
	Движение.Сумма         = Сумма;

	Набор.Записать();
КонецПроцедуры


// заглушка для движений по количеству
// тело не реализовано так как эти движения делает сам документ
Процедура ЗаписатьДвиженияКоличества(Регистратор, ТочкаСсылка, ТРОСсылка, МассивДвижений, ВидДвижения)
	// ничего не делаем
КонецПроцедуры


// перезаписывает движения документа перерасчета в регистре остатков аппаратов
// документ при проведении пишет движения без торговой точки
// из за этого запрос остатков по точке их не находит
// поэтому стираем такие движения и пишем правильные с заполненной точкой
Процедура ПерезаписатьДвиженияПерерасчета(Регистратор, ТочкаСсылка, ТРОСсылка, МассивПриход, МассивРасход)
	Если Не ЗначениеЗаполнено(Регистратор) ИЛИ Не ЗначениеЗаполнено(ТочкаСсылка) Тогда
		Возврат;
	КонецЕсли;

	Набор = РегистрыНакопления.КофейныеАппаратыОстатки.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	// очищаем старые некорректные движения
	Набор.Очистить();

	// движения прихода это товар которого оказалось больше чем в учете
	Если МассивПриход <> Неопределено Тогда
		Для Каждого СтрДв Из МассивПриход Цикл
			Если Не ЗначениеЗаполнено(СтрДв.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			Кол = Число(СтрДв.Количество);
			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Дв = Набор.Добавить();
			Дв.Активность      = Истина;
			Дв.ВидДвижения     = ВидДвиженияНакопления.Приход;
			Дв.Период          = Регистратор.Дата;
			Дв.ТРО             = ТРОСсылка;
			Дв.ТорговаяТочка   = ТочкаСсылка;
			Дв.Номенклатура    = СтрДв.Номенклатура;
			Дв.Количество      = Кол;
		КонецЦикла;
	КонецЕсли;

	// движения расхода это недостача относительно учета
	Если МассивРасход <> Неопределено Тогда
		Для Каждого СтрДв Из МассивРасход Цикл
			Если Не ЗначениеЗаполнено(СтрДв.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			Кол = Число(СтрДв.Количество);
			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Дв = Набор.Добавить();
			Дв.Активность      = Истина;
			Дв.ВидДвижения     = ВидДвиженияНакопления.Расход;
			Дв.Период          = Регистратор.Дата;
			Дв.ТРО             = ТРОСсылка;
			Дв.ТорговаяТочка   = ТочкаСсылка;
			Дв.Номенклатура    = СтрДв.Номенклатура;
			Дв.Количество      = Кол;
		КонецЦикла;
	КонецЕсли;

	Набор.Записать();
КонецПроцедуры


// ============================================================
// метод nomenclature (получение списка точек)
// возвращает точки с долгом блокировками и ассортиментом
// ============================================================
Функция nomenclatureget(Запрос)
	Попытка
		// код сотрудника приходит в параметре u
		КодСотр = СокрЛП(Запрос.ПараметрыЗапроса.Получить("u"));

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// основной запрос по точкам
		// долг берется из регистра взаиморасчетов
		// три блокировки показывают были ли сегодня проведены документы по точке
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Точки.Ссылка КАК ТочкаСсылка,
		|	Точки.Код КАК id,
		|	Точки.Наименование КАК point_name,
		|	ЕСТЬNULL(Точки.Контрагент.Наименование, """") КАК counterparty,
		|	ЕСТЬNULL(Точки.Адрес, """") КАК address,
		|	ЕСТЬNULL(Точки.НоменклатураТРО.Наименование, """") КАК coffee_machine,
		|	ЕСТЬNULL(Точки.НоменклатураТРО.Код, """") КАК coffee_machine_code,
		|	Точки.НоменклатураТРО КАК ТРОСсылка,
		|	ЕСТЬNULL(ОстаткиДолга.СуммаОстаток, 0) КАК debt,
		|	ВЫБОР
		|		КОГДА БлокДок.Точка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК locked,
		|	БлокДок.Дата КАК locked_at,
		|	ВЫБОР
		|		КОГДА БлокЗаказ.Точка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК order_locked,
		|	БлокЗаказ.Дата КАК order_locked_at,
		|	ВЫБОР
		|		КОГДА БлокПерерасчет.Точка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК recount_locked,
		|	БлокПерерасчет.Дата КАК recount_locked_at
		|ИЗ
		|	Справочник.ТорговыеТочки КАК Точки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КофейныеАппаратыОстаткиОстатки.ТорговаяТочка КАК ТорговаяТочка,
		|			СУММА(КофейныеАппаратыОстаткиОстатки.СуммаОстаток) КАК СуммаОстаток
		|		ИЗ
		|			РегистрНакопления.КофеТТВзаиморасчеты.Остатки КАК КофейныеАппаратыОстаткиОстатки
		|		СГРУППИРОВАТЬ ПО
		|			КофейныеАппаратыОстаткиОстатки.ТорговаяТочка) КАК ОстаткиДолга
		|		ПО Точки.Ссылка = ОстаткиДолга.ТорговаяТочка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокТЧ.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокТЧ.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ДокТЧ
		|		ГДЕ
		|			ДокТЧ.Ссылка.Проведен
		|			И ДокТЧ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокТЧ.Ссылка.ТорговаяТочка) КАК БлокДок
		|		ПО Точки.Ссылка = БлокДок.Точка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокЗ.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокЗ.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыПополнениеЗапасов.Состав КАК ДокЗ
		|		ГДЕ
		|			ДокЗ.Ссылка.Проведен
		|			И ДокЗ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокЗ.Ссылка.ТорговаяТочка) КАК БлокЗаказ
		|		ПО Точки.Ссылка = БлокЗаказ.Точка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокП.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокП.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыПерерахунок.Состав КАК ДокП
		|		ГДЕ
		|			ДокП.Ссылка.Проведен
		|			И ДокП.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокП.Ссылка.ТорговаяТочка) КАК БлокПерерасчет
		|		ПО Точки.Ссылка = БлокПерерасчет.Точка
		|ГДЕ
		|	Точки.ПометкаУдаления = ЛОЖЬ";

		// не администратор видит только свои точки
		Если Не Сотр.РольАдминистратора Тогда
			ТекстЗапроса = ТекстЗапроса
				+ Символы.ПС
				+ " И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
		КонецЕсли;

		ЗапросБД = Новый Запрос(ТекстЗапроса);
		ЗапросБД.УстановитьПараметр("ОсновнойМенеджер", Сотр.Ссылка);
		ЗапросБД.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Выборка = ЗапросБД.Выполнить().Выбрать();

		// собираем промежуточный массив и список точек
		Промежуточные = Новый Массив;
		МассивТочек  = Новый Массив;

		Пока Выборка.Следующий() Цикл
			Стр = Новый Структура;
			Стр.Вставить("Точка",              Выборка.ТочкаСсылка);
			Стр.Вставить("id",                 Выборка.id);
			Стр.Вставить("point_name",         Выборка.point_name);
			Стр.Вставить("counterparty",       Выборка.counterparty);
			Стр.Вставить("address",            Выборка.address);
			Стр.Вставить("coffee_machine",     Выборка.coffee_machine);
			Стр.Вставить("coffee_machine_code",Выборка.coffee_machine_code);
			// в регистре долг хранится с обратным знаком поэтому умножаем на минус один
			Стр.Вставить("debt",               Выборка.debt * (-1));
			Стр.Вставить("locked",             Выборка.locked);
			Стр.Вставить("locked_at",          Выборка.locked_at);
			Стр.Вставить("order_locked",       Выборка.order_locked);
			Стр.Вставить("order_locked_at",    Выборка.order_locked_at);
			Стр.Вставить("recount_locked",     Выборка.recount_locked);
			Стр.Вставить("recount_locked_at",  Выборка.recount_locked_at);
			Стр.Вставить("ТРОСсылка",          Выборка.ТРОСсылка);
			Промежуточные.Добавить(Стр);

			Если ЗначениеЗаполнено(Выборка.ТочкаСсылка) Тогда
				МассивТочек.Добавить(Выборка.ТочкаСсылка);
			КонецЕсли;
		КонецЦикла;

		// одним запросом берем последние счетчики по всем точкам
		// ключ в соответствии это точка и номенклатура через вертикальную черту
		// значение это последнее проведенное показание счетчика
		КартаСчетчиков = Новый Соответствие;

		Если МассивТочек.Количество() > 0 Тогда
			ЗапросСчетчиков = Новый Запрос;
			ЗапросСчетчиков.Текст =
			"ВЫБРАТЬ
			|	ТЧ.Ссылка.ТорговаяТочка КАК Точка,
			|	ТЧ.Номенклатура КАК Номенклатура,
			|	ТЧ.СчетчикТекущий КАК Счетчик,
			|	ТЧ.Ссылка.Дата КАК Дата
			|ИЗ
			|	Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ТЧ
			|ГДЕ
			|	ТЧ.Ссылка.Проведен
			|	И ТЧ.Ссылка.ТорговаяТочка В (&Точки)
			|УПОРЯДОЧИТЬ ПО
			|	Точка,
			|	Номенклатура,
			|	Дата УБЫВ";
			ЗапросСчетчиков.УстановитьПараметр("Точки", МассивТочек);

			ВыборкаСч = ЗапросСчетчиков.Выполнить().Выбрать();
			Пока ВыборкаСч.Следующий() Цикл
				Ключ = Строка(ВыборкаСч.Точка) + "|" + Строка(ВыборкаСч.Номенклатура);
				Если КартаСчетчиков[Ключ] = Неопределено Тогда
					// первое вхождение самое свежее так как сортировка по дате убывает
					КартаСчетчиков.Вставить(Ключ, Число(ВыборкаСч.Счетчик));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// формируем итоговый массив для ответа
		МассивДанных = Новый Массив;

		Для Каждого Стр Из Промежуточные Цикл
			СтрокаДанных = Новый Структура;
			СтрокаДанных.Вставить("id",                 Стр.id);
			СтрокаДанных.Вставить("point_name",         Стр.point_name);
			СтрокаДанных.Вставить("counterparty",       Стр.counterparty);
			СтрокаДанных.Вставить("address",            Стр.address);
			СтрокаДанных.Вставить("coffee_machine",     Стр.coffee_machine);
			СтрокаДанных.Вставить("coffee_machine_code",Стр.coffee_machine_code);
			СтрокаДанных.Вставить("debt",               Стр.debt);

			// время блокировки отдаем только если блокировка есть
			СтрокаДанных.Вставить("locked", Стр.locked);
			Если Стр.locked Тогда
				СтрокаДанных.Вставить("locked_at", Формат(Стр.locked_at, "ДЛФ=В"));
			КонецЕсли;

			СтрокаДанных.Вставить("order_locked", Стр.order_locked);
			Если Стр.order_locked Тогда
				СтрокаДанных.Вставить("order_locked_at", Формат(Стр.order_locked_at, "ДЛФ=В"));
			КонецЕсли;

			СтрокаДанных.Вставить("recount_locked", Стр.recount_locked);
			Если Стр.recount_locked Тогда
				СтрокаДанных.Вставить("recount_locked_at", Формат(Стр.recount_locked_at, "ДЛФ=В"));
			КонецЕсли;

						// ассортимент берем из табличной части оборудования
			// заодно считаем общий счетчик как сумму последних показаний по всем позициям
			МассивАссортимента = Новый Массив;
			ОбщийСчетчик = 0;
			ИспользоватьОбщийСчетчик = Ложь;

			Если ЗначениеЗаполнено(Стр.ТРОСсылка) Тогда
				// галочку читаем только если такой реквизит есть у оборудования
				Если Стр.ТРОСсылка.Метаданные().Реквизиты.Найти("ИспользоватьОбщийСчетчик") <> Неопределено Тогда
					ИспользоватьОбщийСчетчик = (Стр.ТРОСсылка.ИспользоватьОбщийСчетчик = Истина);
				КонецЕсли;

				Для Каждого СтрокаТЧ Из Стр.ТРОСсылка.АссортиментыПоТоварам Цикл
					Ключ = Строка(Стр.Точка) + "|" + Строка(СтрокаТЧ.Номенклатура);

					// если показаний еще не было считаем что счетчик нулевой
					ПоследнийСчетчик = 0;
					Если КартаСчетчиков[Ключ] <> Неопределено Тогда
						ПоследнийСчетчик = КартаСчетчиков[Ключ];
					КонецЕсли;

					ОбщийСчетчик = ОбщийСчетчик + ПоследнийСчетчик;

					СтруктураАссортимента = Новый Структура;
					СтруктураАссортимента.Вставить("code",       СтрокаТЧ.Номенклатура.Код);
					СтруктураАссортимента.Вставить("name",       СтрокаТЧ.Номенклатура.Наименование);
					СтруктураАссортимента.Вставить("price",      СтрокаТЧ.Цена);
					СтруктураАссортимента.Вставить("last_meter", ПоследнийСчетчик);
					МассивАссортимента.Добавить(СтруктураАссортимента);
				КонецЦикла;
			КонецЕсли;

			// флаг и значение общего счетчика для фронта
			СтрокаДанных.Вставить("use_total_counter", ИспользоватьОбщийСчетчик);
			СтрокаДанных.Вставить("total_counter", ?(ИспользоватьОбщийСчетчик, ОбщийСчетчик, 0));

			СтрокаДанных.Вставить("assortment", МассивАссортимента);
			МассивДанных.Добавить(СтрокаДанных);
		КонецЦикла;

		// сериализуем в json
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		// успешный ответ с заголовками для cors
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		// ответ с ошибкой тоже содержит заголовок cors иначе браузер скроет текст ошибки
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("Помилка 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода nomenclature
