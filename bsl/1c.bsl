// ============================================================

Функция POST_Payment(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки = Данные.point_id;
		КодСотр  = Данные.technician_id;
		Сумма    = Число(Данные.amount);

		Если Сумма <= 0 Тогда
			ВызватьИсключение "Сума оплати має бути більше нуля.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		ПКО = Документы.ПКО.СоздатьДокумент();
		ПКО.Дата = ТекущаяДата();

		Попытка
			ПКО.Контрагент = ТочкаСсылка.Контрагент;
		Исключение
		КонецПопытки;

		Если ТочкаСсылка.Метаданные().Реквизиты.Найти("Магазин") <> Неопределено
			И ЗначениеЗаполнено(ТочкаСсылка.Магазин) Тогда

			Попытка
				ПКО.Магазин = ТочкаСсылка.Магазин;
			Исключение
			КонецПопытки;

			Если ТочкаСсылка.Магазин.Метаданные().Реквизиты.Найти("Организация") <> Неопределено
				И ЗначениеЗаполнено(ТочкаСсылка.Магазин.Организация) Тогда
				Попытка
					ПКО.Организация = ТочкаСсылка.Магазин.Организация;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

		Попытка
			Если Не ЗначениеЗаполнено(ПКО.Организация) Тогда
				ПКО.Организация = Константы.ОрганизацияПоУмолчанию.Получить();
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			Если Не ЗначениеЗаполнено(ПКО.Касса) Тогда
				ЗапросКасса = Новый Запрос;
				ЗапросКасса.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
				|ИЗ Справочник.Кассы
				|ГДЕ НЕ ПометкаУдаления";
				ВыборкаКасса = ЗапросКасса.Выполнить().Выбрать();
				Если ВыборкаКасса.Следующий() Тогда
					ПКО.Касса = ВыборкаКасса.Ссылка;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Сумма = Сумма;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.ВидОперации = Перечисления.ВидыОперацийПКО.ПрочийПриход;
		Исключение
			Попытка
				ПКО.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаОтПокупателя;
			Исключение
			КонецПопытки;
		КонецПопытки;

		СотрАвтор = НайтиСотрудника(КодСотр);
		Если Не СотрАвтор.Пустая() Тогда
			Попытка
				ПКО.Автор = СотрАвтор;
			Исключение
			КонецПопытки;

			Попытка
				ПКО.ПринятоОт = СотрАвтор.Наименование;
			Исключение
			КонецПопытки;

			Попытка
				ПКО.Менеджер = СотрАвтор;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Попытка
			ПКО.Комментарий = "Оплата боргу через мобільний додаток (" 
				+ СокрЛП(ТочкаСсылка.Наименование) + ")";
		Исключение
		КонецПопытки;

		ОшибкаПроведенияПКО = "";
		Попытка
			ПКО.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОшибкаПроведенияПКО = ОписаниеОшибки();
			Попытка
				ПКО.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				ВызватьИсключение "Не вдалося записати ПКО: " + ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;

		ЗаписатьДвижениеДолга(
			ПКО.Ссылка,
			ТочкаСсылка,
			Сумма,
			ВидДвиженияНакопления.Расход
		);

		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(ПКО.Номер));
		Результат.Вставить("doc_date",      Формат(ПКО.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("conduct_error", ОшибкаПроведенияПКО);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


