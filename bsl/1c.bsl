	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
	Возврат Ответ;
КонецФункции


// ============================================================
// метод meters (внесение показаний счетчиков)
// создает документ обслуживания и записывает движение долга
// ============================================================
Функция POST_Meters(Запрос)
	Попытка
		// читаем тело запроса как json
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки = Данные.point_id;
		МассивСтрок = Данные.meters;
		КодСотр = Данные.technician_id;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если в конфигурации есть реквизит ID_Запроса)
		ЕстьIDЗапроса = ЕстьРеквизитIDЗапроса("КофейныеАппаратыОбслуживание");
		Если ЕстьIDЗапроса И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КофейныеАппаратыОбслуживание ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				Результат = Новый Структура("ok, sum, debt_error, stock_error", Истина, 0, "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат); СтрокаJSON = ЗаписьJSON.Закрыть();
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		// сотрудник должен существовать
		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(КодТочки);
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена!.";
		КонецЕсли;

		// не администратор не может вносить показания по точке дважды за день
		Если Не Сотр.РольАдминистратора Тогда
			ЗапросПроверки = Новый Запрос;
			ЗапросПроверки.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДокТЧ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ДокТЧ
			|ГДЕ
			|	ДокТЧ.Ссылка.Проведен
			|	И ДокТЧ.Ссылка.ТорговаяТочка = &ТорговаяТочка
			|	И ДокТЧ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)";
			ЗапросПроверки.УстановитьПараметр("ТорговаяТочка", ТочкаСсылка);
			ЗапросПроверки.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

			Если Не ЗапросПроверки.Выполнить().Пустой() Тогда
				// код 409 означает что показания уже внесены
				Ответ = Новый HTTPСервисОтвет(409);
				Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
				Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
				Ответ.УстановитьТелоИзСтроки("Показники по цій точці вже внесені сьогодні.", КодировкаТекста.UTF8);
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		// готовим документ обслуживания (пока без записи в базу)
		НовыйДок = Документы.КофейныеАппаратыОбслуживание.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.Автор = Пользователь;
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО = ТочкаСсылка.НоменклатураТРО;
		
		// ID_Запроса пишем только если реквизит существует в конфигурации
		Если ЕстьIDЗапроса Тогда
			Попытка НовыйДок.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		ОборудованиеОбъект = ТочкаСсылка.НоменклатураТРО.ПолучитьОбъект();

		// ищем запасную технологическую карту на случай если у позиции своей нет
		// сначала берем первую заполненную карту из ассортимента оборудования
		РезКалькуляция = Неопределено;
		Если ОборудованиеОбъект <> Неопределено И ОборудованиеОбъект.АссортиментыПоТоварам.Количество() > 0 Тогда
			Для Каждого СтрОбор Из ОборудованиеОбъект.АссортиментыПоТоварам Цикл
				Если ЗначениеЗаполнено(СтрОбор.ТехнологическаяКарта) Тогда
					РезКалькуляция = СтрОбор.ТехнологическаяКарта;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// раньше тут был fallback на первую попавшуюся калькуляцию из базы
		// но это тихо портило себестоимость
		// поэтому теперь если карт нет вообще просто падаем с понятной ошибкой
		Если Не ЗначениеЗаполнено(РезКалькуляция) Тогда
			ВызватьИсключение
				"Для жодної позиції в асортименті обладнання не вказано технологічну карту. "
				+ "Заповніть карти в 1С перед зняттям показників.";
		КонецЕсли;

		СуммаОбщая = 0;

		// заполняем табличную часть по строкам из запроса
		Для Каждого Стр Из МассивСтрок Цикл
			НоваяТЧ = НовыйДок.Ассортимент.Добавить();

			// ищем строго по коду, для совместимости пробуем по имени
			КодТовара = ""; Если Стр.Свойство("code") Тогда КодТовара = СокрЛП(Стр.code); КонецЕсли;
			ИмяТовара = ""; Если Стр.Свойство("name") Тогда ИмяТовара = СокрЛП(Стр.name); КонецЕсли;

			ЭлементНоменклатуры = Справочники.Номенклатура.ПустаяСсылка();
			Если Не ПустаяСтрока(КодТовара) Тогда
				Попытка ЭлементНоменклатуры = Справочники.Номенклатура.НайтиПоКоду(КодТовара); Исключение КонецПопытки;
			КонецЕсли;
			Если ЭлементНоменклатуры.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				ЭлементНоменклатуры = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;

			// предыдущий счетчик по умолчанию нулевой
			ПрошлыйСчетчик = 0;
			ЦенаИзБазы = 0;

			Если Не ЭлементНоменклатуры.Пустая() Тогда
				НоваяТЧ.Номенклатура = ЭлементНоменклатуры;

				НайденнаяКарта = Неопределено;

				// ищем эту позицию в ассортименте оборудования
				// чтобы взять ее технологическую карту
				Если ОборудованиеОбъект <> Неопределено Тогда
					Для Каждого СтрОборудования Из ОборудованиеОбъект.АссортиментыПоТоварам Цикл
						Если СтрОборудования.Номенклатура = ЭлементНоменклатуры Тогда
							НайденнаяКарта = СтрОборудования.ТехнологическаяКарта;
							// прошлый счетчик равен текущему минус дельта
							// фронт передает оба значения
							ПрошлыйСчетчик = Стр.value - Стр.delta;
							ЦенаИзБазы = СтрОборудования.Цена;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;

				// если у позиции нет своей карты берем запасную
				Если Не ЗначениеЗаполнено(НайденнаяКарта) Тогда
					НайденнаяКарта = РезКалькуляция;
				КонецЕсли;

				Если ЗначениеЗаполнено(НайденнаяКарта) Тогда
					НоваяТЧ.ТехнологическаяКарта = НайденнаяКарта;
				КонецЕсли;
			КонецЕсли;

			НоваяТЧ.Счетчик = ПрошлыйСчетчик;
			НоваяТЧ.Цена = ЦенаИзБазы;
			НоваяТЧ.СчетчикТекущий = Стр.value;
			НоваяТЧ.Количество = Стр.delta;
			НоваяТЧ.Сумма = Стр.delta * ЦенаИзБазы; // рассчитываем сумму на сервере

			СуммаОбщая = СуммаОбщая + НоваяТЧ.Сумма;
		КонецЦикла;

		// записываем сумму в шапку если такой реквизит есть
		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаОбщая;
		КонецЕсли;

		// документ и движение долга пишутся в одной транзакции
		// если что то упадет откатится все и клиент получит ошибку
		НачатьТранзакцию();
		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);

			// показатели увеличивают долг поэтому вид движения расход
			ЗаписатьДвижениеДолга(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				СуммаОбщая,
				ВидДвиженияНакопления.Расход
			);

			ЗафиксироватьТранзакцию();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("КофеПриложение.Показатели", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстОшибки);
			ВызватьИсключение "Показники не збережено: " + ТекстОшибки;
		КонецПопытки;

		// поля с ошибками оставляем пустыми чтобы фронт не сломался
		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("sum", СуммаОбщая);
		Результат.Вставить("debt_error", "");
		Результат.Вставить("stock_error", "");

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода meters
Функция OPTIONS_Meters(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
	Возврат Ответ;
КонецФункции


// ============================================================
// метод payment (оплата долга)
// создает приходный кассовый ордер и документ погашения долга
// ============================================================
Функция POST_Payment(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки = Данные.point_id;
		КодСотр  = Данные.technician_id;
		Сумма    = Число(Данные.amount);
		
		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если у ПКО есть реквизит ID_Запроса)
		ЕстьIDПКО = ЕстьРеквизитIDЗапроса("ПКО");
		Если ЕстьIDПКО И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ПКО ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				Результат = Новый Структура("ok, doc_number, doc_date, conduct_error", Истина, "", "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат);
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// значения по умолчанию берем из настроек пользователя
		ОсновнойМагазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
		ОсновнаяКасса = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяКасса");
		ОсновнаяОрганизация = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяОрганизация");

		Если Сумма <= 0 Тогда
			ВызватьИсключение "Сума оплати має бути більше нуля.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// готовим приходный кассовый ордер (пока без записи в базу)
		ПКО = Документы.ПКО.СоздатьДокумент();
		ПКО.Дата = ТекущаяДата();
		ПКО.Организация = ОсновнаяОрганизация;
		ПКО.Магазин = ОсновнойМагазин;
		ПКО.Касса = ОсновнаяКасса;
		ПКО.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;

		Если ЕстьIDПКО Тогда
			Попытка ПКО.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		// реквизиты которых может не быть в конфигурации заполняем в попытке
		Попытка
			ПКО.Контрагент = ТочкаСсылка.Контрагент;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Сумма = Сумма;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Автор = Пользователь;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.ПринятоОт = Сотр.Наименование;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Менеджер = Сотр;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Комментарий = "Оплата боргу через мобільний додаток ("
				+ СокрЛП(ТочкаСсылка.Наименование) + ")";
		Исключение
		КонецПопытки;

		// готовим документ погашения долга
		Док = Документы.КофейныеАппаратыПогашениеДолга.СоздатьДокумент();
		Док.Дата = ТекущаяДата();
		Док.Автор = Пользователь;
		Док.Организация = ОсновнаяОрганизация;
		Док.Магазин = ОсновнойМагазин;
		Док.Контрагент = ТочкаСсылка.Контрагент;
		Док.ТРО = ТочкаСсылка.НоменклатураТРО;
		Док.ТорговаяТочка = ТочкаСсылка;
		Док.Сумма = Сумма;

		// для второго документа используем другой ID
		// чтобы уникальность не сработала на ПКО и погашении сразу
		// пишем только если реквизит существует
		Если ЕстьРеквизитIDЗапроса("КофейныеАппаратыПогашениеДолга") Тогда
			Попытка Док.ID_Запроса = RequestID + "-d"; Исключение КонецПопытки;
		КонецЕсли;

		// все что пишет в базу идет в одной транзакции
		// иначе можно получить деньги в кассе без уменьшения долга
		НачатьТранзакцию();
		Попытка
			ПКО.Записать(РежимЗаписиДокумента.Проведение);
			Док.Записать(РежимЗаписиДокумента.Проведение);

			// оплата уменьшает долг поэтому вид движения приход
			ЗаписатьДвижениеДолга(
				Док.Ссылка,
				ТочкаСсылка,
				Сумма,
				ВидДвиженияНакопления.Приход
			);

			ЗафиксироватьТранзакцию();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("КофеПриложение.Оплата", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстОшибки);
			ВызватьИсключение "Оплату не проведено: " + ТекстОшибки;
		КонецПопытки;

		// пустое поле conduct_error означает для фронта что все прошло успешно
		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(ПКО.Номер));
		Результат.Вставить("doc_date",      Формат(ПКО.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("conduct_error", "");

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


